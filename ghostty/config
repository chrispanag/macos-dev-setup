# ============================================
# Ghostty Terminal Configuration
# ============================================
# File: ~/.config/ghostty/config (symlinked from macos-setup/ghostty/config)
# Reload: Cmd+Shift+, (macOS)
# Only non-default settings live here. View all options and defaults:
#   ghostty +show-config --default --docs
#   ghostty +list-keybinds --default

# --- Typography ---
font-family = JetBrainsMono Nerd Font Mono
font-size = 14
font-thicken = true
adjust-cell-height = 10%

# --- Theme and Colors ---
# Catppuccin Mocha, always dark (window chrome follows the dark background).
theme = Catppuccin Mocha

# --- Window and Appearance ---
background-opacity = 0.85
background-blur = 16
window-padding-x = 10
window-padding-y = 8
window-save-state = always

# --- Cursor ---
cursor-style = bar
cursor-opacity = 0.8

# --- Keyboard ---
# Left Option sends Alt (zsh word-motions); right Option still types unicode.
macos-option-as-alt = left

# --- Mouse ---
mouse-hide-while-typing = true

# --- Quick Terminal (Quake-style dropdown) ---
quick-terminal-screen = mouse
quick-terminal-animation-duration = 0.15

# --- Shell Integration ---
# ssh-env/ssh-terminfo keep TERM usable on remote hosts that don't know xterm-ghostty.
shell-integration-features = sudo,ssh-env,ssh-terminfo

# --- Project picker ---
# Shells Ghostty opens start in bin/tmux-project (see zsh/.zshrc); Esc gives a
# plain shell. Child processes don't inherit it: .zshrc unsets it.
env = TMUX_PROJECT_AUTOSTART=1

# --- Updates ---
# Homebrew installs Ghostty; Ghostty keeps itself up to date.
auto-update = download

# --- Keybindings (in addition to the macOS defaults) ---
# Tabs
keybind = cmd+shift+arrow_left=previous_tab
keybind = cmd+shift+arrow_right=next_tab

# Splits (zoom is the default cmd+shift+enter)
keybind = cmd+shift+e=equalize_splits

# Quick terminal global hotkey. Needs Accessibility permission for Ghostty
# (System Settings > Privacy & Security > Accessibility), otherwise it does nothing.
keybind = global:ctrl+grave_accent=toggle_quick_terminal
