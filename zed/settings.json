// Zed settings (symlinked from macos-setup/zed/settings.json)
//
// Only non-default settings live here. See all defaults with
// `zed: open default settings` from the command palette (cmd-shift-p).
// Docs: https://zed.dev/docs/configuring-zed
{
  "base_keymap": "VSCode",

  // --- Fonts: same Nerd Font as Ghostty ---
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 15,
  "terminal": {
    // Needed for starship prompt icons in the built-in terminal
    "font_family": "JetBrainsMono Nerd Font Mono"
  },

  // --- Theme: Catppuccin, following the macOS appearance ---
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },

  "minimap": {
    "show": "always"
  },

  // --- Panels: files on the left, agent on the right ---
  "project_panel": {
    "dock": "left",
    "default_width": 240.0,
    "git_status_indicator": true
  },
  "agent": {
    "dock": "right",
    "threads_sidebar": {
      "position": "right"
    }
  },

  // Installed automatically on a fresh machine
  "auto_install_extensions": {
    "biome": true,
    "catppuccin": true,
    "golangci-lint": true,
    "html": true,
    "proto": true,
    "starlark": true
  },

  // --- AI ---
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "auto"
      },
      "type": "registry"
    }
  }
}
