#!/usr/bin/env zsh
# Pick a project with fzf and switch to its tmux session, creating the session
# (named after the folder, started in it) if the folder has none yet. Each
# Ghostty tab gets a session of its own: if the project is already open in
# another tab, this one gets a separate session with its own windows. Sessions
# no tab shows (their tab closed) are reused; a second fzf list asks which one,
# or a name for a new one, when there's a choice.
#
#   tmux-project          pick from zoxide's directories (most used first),
#                         then the git repos in ~/Developer
#   tmux-project <dir>    use <dir> directly
#
# Bound to Ctrl+G in zsh (runs inline) and prefix + j in tmux (in a popup), and
# run when Ghostty opens a shell (TMUX_PROJECT_AUTOSTART, see zsh/.zshrc).
setopt err_exit no_unset pipe_fail

if (( $# )); then
  dir=${1:A}
  [[ -d $dir ]] || { print -u2 "tmux-project: not a directory: $dir"; exit 1; }
else
  # zoxide only lists directories that still exist; the glob finds existing
  # repos. Duplicates go (first, highest-ranked wins). Shown with ~, returned
  # as full paths. A failing zoxide still leaves the repos to pick from.
  dirs=( ${(f)"$(zoxide query --list 2> /dev/null || :)"} ~/Developer/*/.git(N:h) )
  dir=$(for d in ${(u)dirs:#/}; do print -r -- "$d"$'\t'"${(D)d}"; done |
        fzf --delimiter='\t' --with-nth=2 --accept-nth=1 --prompt='project> ' \
          --reverse --height=${TMUX_PROJECT_HEIGHT:-50%} \
          --preview='eza -1 --icons=always --group-directories-first {1}') ||
    exit 0  # Esc or Ctrl+C: do nothing
fi

# Sessions as "path<Tab>attached clients<Tab>windows<Tab>last used<Tab>name"
# lines; none without a server.
sessions=( ${(f)"$(tmux list-sessions -F '#{session_path}'$'\t''#{session_attached}'$'\t''#{session_windows}'$'\t''#{session_activity}'$'\t''#{session_name}' 2> /dev/null || :)"} )
# The tmux client to act on: the prefix + j popup passes its own, because tmux
# would otherwise guess (the most recently active one); elsewhere, this pane's.
client=( ${TMUX_PROJECT_CLIENT:+-c} ${TMUX_PROJECT_CLIENT:+$TMUX_PROJECT_CLIENT} )
current=${TMUX:+$(tmux display-message $client -p '#S')}
# This tab's own session for this folder wins. Otherwise collect the ones no
# tab shows (free: their tab closed) as fzf lines, and note if another tab has
# the folder open.
name= label= free=() busy=0
base=${${${dir:t}//[.:]/_}:-root}
zmodload -F zsh/datetime p:EPOCHSECONDS
for s in $sessions; do
  fields=( "${(@ps:\t:)s}" )
  [[ $fields[1] == "$dir" ]] || continue
  if [[ $fields[5] == "$current" ]]; then name=$fields[5]; break; fi
  if (( fields[2] )); then busy=1; continue; fi
  age=$(( (EPOCHSECONDS - fields[4]) / 60 ))
  if (( age < 60 )); then age=${age}m; elif (( age < 1440 )); then age=$(( age / 60 ))h; else age=$(( age / 1440 ))d; fi
  # name, then what fzf shows and matches: the part after the "<project>-"
  # prompt, and the session's size and age
  free+=( "$fields[5]"$'\t'"${fields[5]#$base-}"$'\t'"$fields[3] window${${fields[3]:#1}:+s}, used $age ago" )
done

# Only one way to go: a single free session, or none at all. Otherwise ask:
# pick a free session, or type a name for a new one (Enter on "+ new session",
# or typing +, numbers it). Ctrl+X kills the highlighted free session.
if [[ -z $name ]] && (( busy || $#free > 1 )); then
  name=$(print -rl -- $free "+"$'\t'"+"$'\t'"new session" |
         fzf --delimiter='\t' --with-nth=2,3 --nth=1 --accept-nth=1 --exact --reverse \
           --height=${TMUX_PROJECT_HEIGHT:-50%} --prompt="$base-" \
           --header="${(D)dir}: pick a session, or type a name for a new one (ctrl-x kills)" \
           --bind='enter:accept-or-print-query' \
           --bind='ctrl-x:transform:[ {1} = + ] || echo "execute-silent(tmux kill-session -t={1})+exclude"') ||
    exit 0  # Esc or Ctrl+C: do nothing
  free=( ${free%%$'\t'*} )
  (( ${free[(Ie)$name]} )) || label=${${name#+}//[[:space:].:]/_} name=
else
  name=${name:-${${free[1]-}%%$'\t'*}}
fi

if [[ -n $name ]]; then
  cmd=( attach-session -t "=$name" )
  [[ -z $current ]] || cmd=( switch-client $client -t "=$name" )
else
  # A new session named after the folder (tmux names can't contain . or :, see
  # base above), plus the typed label if any; -2, -3, ... if the name is taken.
  names=( ${sessions##*$'\t'} )
  base=$base${label:+-$label} name=$base n=1
  while (( ${names[(Ie)$name]} )); do name=$base-$(( ++n )); done
  # Outside tmux, new-session attaches by itself.
  cmd=( new-session ${current:+-d} -s "$name" -c "$dir" )
  [[ -z $current ]] || cmd+=( ';' switch-client $client -t "=$name" )
fi
exec tmux $cmd
