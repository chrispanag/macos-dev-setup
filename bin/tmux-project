#!/usr/bin/env zsh
# Pick a project with fzf and switch to its tmux session, creating the session
# (named after the folder, started in it) if the folder has none yet. If the
# project is already open in another tab, this tab gets a grouped session: the
# same windows, but its own current window. tmux removes an unattached session
# that has others in its group (destroy-unattached keep-last in tmux.conf).
#
#   tmux-project          pick from zoxide's directories (most used first),
#                         then the git repos in ~/Developer
#   tmux-project <dir>    use <dir> directly
#
# Bound to Ctrl+G in zsh (runs inline) and prefix + j in tmux (in a popup), and
# run when Ghostty opens a shell (TMUX_PROJECT_AUTOSTART, see zsh/.zshrc).
setopt err_exit no_unset pipe_fail

if (( $# )); then
  dir=${1:A}
  [[ -d $dir ]] || { print -u2 "tmux-project: not a directory: $dir"; exit 1; }
else
  # zoxide only lists directories that still exist; the glob finds existing
  # repos. Duplicates go (first, highest-ranked wins). Shown with ~, returned
  # as full paths. A failing zoxide still leaves the repos to pick from.
  dirs=( ${(f)"$(zoxide query --list 2> /dev/null || :)"} ~/Developer/*/.git(N:h) )
  dir=$(for d in ${(u)dirs:#/}; do print -r -- "$d"$'\t'"${(D)d}"; done |
        fzf --delimiter='\t' --with-nth=2 --accept-nth=1 --prompt='project> ' \
          --reverse --height=${TMUX_PROJECT_HEIGHT:-50%} \
          --preview='eza -1 --icons=always --group-directories-first {1}') ||
    exit 0  # Esc or Ctrl+C: do nothing
fi

# Sessions as "path<Tab>attached clients<Tab>name" lines; none without a server.
sessions=( ${(f)"$(tmux list-sessions -F '#{session_path}'$'\t''#{session_attached}'$'\t''#{session_name}' 2> /dev/null || :)"} )
# The tmux client to act on: the prefix + j popup passes its own, because tmux
# would otherwise guess (the most recently active one); elsewhere, this pane's.
client=( ${TMUX_PROJECT_CLIENT:+-c} ${TMUX_PROJECT_CLIENT:+$TMUX_PROJECT_CLIENT} )
current=${TMUX:+$(tmux display-message $client -p '#S')}
# Reuse this tab's own session for this folder, else a free one; else remember
# one that's open elsewhere to group with.
name= busy=
for s in $sessions; do
  fields=( "${(@ps:\t:)s}" )
  [[ $fields[1] == "$dir" ]] || continue
  if [[ $fields[3] == "$current" ]]; then name=$fields[3]; break; fi
  if (( fields[2] == 0 )); then name=${name:-$fields[3]}; else busy=${busy:-$fields[3]}; fi
done

if [[ -n $name ]]; then
  cmd=( attach-session -t "=$name" )
  [[ -z $current ]] || cmd=( switch-client $client -t "=$name" )
else
  # A new session named after the folder (tmux names can't contain . or :),
  # with -2, -3, ... if taken; grouped with $busy if there is one. Created and
  # attached in one tmux command: keep-last would remove a grouped session that
  # sits unattached even briefly.
  names=( ${sessions##*$'\t'} )
  base=${${${dir:t}//[.:]/_}:-root} name=$base n=1
  while (( ${names[(Ie)$name]} )); do name=$base-$(( ++n )); done
  # Outside tmux, new-session attaches by itself.
  cmd=( new-session ${current:+-d} ${busy:+"-t=$busy"} -s "$name" -c "$dir" )
  [[ -z $current ]] || cmd+=( ';' switch-client $client -t "=$name" )
fi
exec tmux $cmd
