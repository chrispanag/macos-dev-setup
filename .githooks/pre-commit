#!/bin/sh
# Block commits that add secrets, emails or home-directory paths (rules in
# .gitleaks.toml). Enabled by `git config core.hooksPath .githooks`, which
# install.sh sets. For a false positive, fix the rule or commit with --no-verify.

if ! command -v gitleaks > /dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks), so the commit is blocked." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --no-banner --redact --verbose --config .gitleaks.toml
